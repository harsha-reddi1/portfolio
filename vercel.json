{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/$1"
    },
    {
      "source": "/((?!api|assets/|favicon\\.svg|icons\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
